# ============================================================
# mst-ytdl environment sample — copy to `.env` and adjust.
# `.env` is GITIGNORED: never commit real credentials/cookies.
# Keys match configs/config.py field names (env_prefix + field),
# case-insensitively.
# ============================================================

# ── Redis (Huey broker + job/item state) ────────────────────
REDIS_URL=redis://localhost:6379/0
# Prefix for every Redis key this app writes (shared Redis safe)
REDIS_KEY_PREFIX=YTDL

# ── FastAPI ─────────────────────────────────────────────────
# Default binds loopback only — this app fetches URLs on your behalf, so
# expose it (0.0.0.0) only behind your own auth / reverse proxy.
API_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=["*"]

# ── Downloads ───────────────────────────────────────────────
# Relative paths are resolved against the repo root.
DL_DOWNLOADS_DIR=downloads
# Single videos land in <downloads>/<today in DL_TIMEZONE, DL_DATE_FOLDER_FORMAT>/
# Playlists land in <downloads>/<playlist name>/
DL_TIMEZONE=Asia/Kolkata
DL_DATE_FOLDER_FORMAT=%Y-%m-%d
# Prefix playlist files with their position: "01 - Title.mp3"
DL_PLAYLIST_NUMBERING=true
# Append " [video_id]" to filenames (avoids same-title collisions)
DL_INCLUDE_ID_IN_NAME=false
DL_MAX_PLAYLIST_ITEMS=500
DL_DEFAULT_FORMAT=mp3
DL_DEFAULT_AUDIO_QUALITY=192
DL_DEFAULT_VIDEO_QUALITY=1080
# Segments fetched in parallel INSIDE one download (HLS/DASH)
DL_CONCURRENT_FRAGMENTS=4
# Per-download network retries inside yt-dlp
DL_NETWORK_RETRIES=5
# Global speed cap per download, e.g. 500K, 2M (empty = unlimited)
DL_SPEED_LIMIT=
DL_EMBED_METADATA=true
DL_EMBED_THUMBNAIL=true
# Absolute path to ffmpeg; empty = PATH, then the bundled imageio-ffmpeg binary
DL_FFMPEG_PATH=
# JS runtime for YouTube challenges: auto | deno | node | bun | quickjs
DL_JS_RUNTIME=auto
# Optional: Netscape cookies file (age-gated / members content) — keep it out of git
# Docker: export cookies.txt to ./cookies/ and set DL_COOKIES_FILE=/app/cookies/cookies.txt
DL_COOKIES_FILE=
# Optional: e.g. chrome / firefox / edge — host only, does NOT work inside Docker
DL_COOKIES_FROM_BROWSER=
DL_PROXY=
# Lyrics for the player (LRCLIB API, no key). Empty = lyrics off. Only artist / title / duration are sent.
DL_LYRICS_URL=https://lrclib.net
# Hosts the API accepts URLs from
DL_ALLOWED_HOSTS=["youtube.com","www.youtube.com","m.youtube.com","music.youtube.com","youtu.be"]

# ── Task queue (Huey) ───────────────────────────────────────
# Consumer threads = hard ceiling for parallel downloads.
TASK_WORKERS=6
# Soft limit (adjustable at runtime from the UI), capped by TASK_MAX_PARALLEL_CAP
TASK_MAX_PARALLEL=3
TASK_MAX_PARALLEL_CAP=12
# Automatic retries for transient failures (not for private/unavailable videos)
TASK_RETRY_COUNT=1
TASK_RETRY_DELAY=10
# Records (job/item hashes) live this many days after their last update
TASK_RECORD_RETENTION_DAYS=30
# Run tasks inline with in-memory storage (tests only)
# Progress lines in the worker log (docker logs): off | milestones (every 10% / 10 s) | verbose (every 5% / 5 s)
TASK_LOG_PROGRESS=milestones
TASK_IMMEDIATE=false

# ── Logging ─────────────────────────────────────────────────
# All log files go to one directory (default ./logs, gitignored): api.log, worker.log, *.errors.log, access.log
LOG_DIR=
# Also write rotating files (5 MB x 5) next to the console output
LOG_TO_FILE=true
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# ── Server mode (public / multi-user deployment) ────────────
# false (default): personal downloader — everything above applies, nothing below matters.
# true: every visitor gets a private queue; finished downloads are handed to the browser
#       (one file, or a ZIP for playlists / the cart) and deleted from the server after
#       SERVER_DELIVERY_TTL_MINUTES. Library edits, cookies and limits need the admin password.
SERVER_MODE=false
# Generate with:  uv run python main.py hash-password   (never put the plain password here)
SERVER_ADMIN_PASSWORD_HASH=
SERVER_ADMIN_SESSION_HOURS=12
# How long a prepared file / ZIP stays downloadable before the sweep deletes it
SERVER_DELIVERY_TTL_MINUTES=60
# Unfinished downloads per visitor, tracks per playlist / cart
SERVER_MAX_ACTIVE_JOBS=5
SERVER_MAX_JOB_ITEMS=100
# Refuse new downloads when the downloads disk has less free space than this
SERVER_MIN_FREE_MB=2048
# Preview / search / submit calls per IP and minute
SERVER_RATE_LIMIT_PER_MINUTE=60
# Cache previews, searches and playlists this long (0 = off)
SERVER_CACHE_MINUTES=10
# Visitors may paste their OWN YouTube cookies (Settings); kept this long in Redis, used only for them
SERVER_VISITOR_COOKIE_HOURS=24
# true = visitors without their own cookies use the server's cookies file (normally: no cookies)
SERVER_SHARE_SERVER_COOKIES=false
# Hard speed ceiling per download, e.g. 5M (empty = none). TASK_MAX_PARALLEL_CAP is the parallel ceiling.
SERVER_MAX_SPEED=
